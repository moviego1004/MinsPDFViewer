<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
     <GenerateAssemblyInfo>false</GenerateAssemblyInfo> 
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\MinsPDFViewer\MinsPDFViewer.csproj" />
  </ItemGroup>

  <!--
    앱은 self-contained(런타임 동봉)라, 참조하면 앱 exe만 이 출력 폴더로 복사되고 런타임은 빠진다.
    그 exe는 실행되지 않으므로("You must install .NET Desktop Runtime") 지운다. 테스트는 dll만 쓴다.
    앱 실행: build\<구성>\MinsPDFViewer\MinsPDFViewer.exe (Directory.Build.props)
  -->
  <Target Name="RemoveCopiedAppHost" AfterTargets="Build">
    <Delete Files="$(OutDir)MinsPDFViewer.exe" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    
    <PublishTrimmed>false</PublishTrimmed> 
    <DebugType>embedded</DebugType>

    <ApplicationIcon>Assets\MinsPDFViewer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- PDFium 엔진 (Google PDFium 빌드, Apache-2.0). 버전 고정: 올릴 때는 doc/개발계획.md 4.2의 점검표대로 -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="158.0.8111" />
    
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="6.0.0" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />

    <Resource Include="Assets\MinsPDFViewer.ico" />
  </ItemGroup>

</Project>

<Window x:Class="MinsPDFViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MinsPDFViewer"
        mc:Ignorable="d"
        Title="MinsPDFViewer"
        x:Name="RootWindow"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewDragOver="Window_DragOver"
        Height="800"
        Width="1200"
        UseLayoutRounding="True"
        Icon="/Assets/MinsPDFViewer.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseUp="Window_PreviewMouseUp"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        Closing="Window_Closing">

        <Window.Resources>
                <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
                <local:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>

                <DataTemplate x:Key="SignaturePlaceholderTemplate">
                        <Grid Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        Cursor="SizeAll"
                                        PreviewMouseDown="AnnotationDragHandle_PreviewMouseDown">
                                <Rectangle Stroke="Red"
                                                StrokeThickness="2"
                                                StrokeDashArray="4 2"
                                                Fill="#10FF0000"/>
                                <TextBlock Text="더블 클릭하여&#x0a;서명 수행"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                TextAlignment="Center"
                                                Foreground="Red"
                                                FontWeight="Bold"/>
                                <Image Source="{Binding VisualStampPath}"
                                                Stretch="Fill"
                                                Opacity="0.9"/>
                                <Rectangle Stroke="Blue"
                                                StrokeThickness="1"
                                                StrokeDashArray="2 2"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Thumb HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Width="10"
                                                Height="10"
                                                Cursor="SizeNWSE"
                                                DragDelta="ResizeThumb_DragDelta"
                                                Background="Red"
                                                Opacity="0.5"/>
                        </Grid>
                </DataTemplate>

                <DataTemplate x:Key="FreeTextTemplate">
                        <Grid Width="{Binding Width}"
                                        Height="{Binding Height}">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                                BorderBrush="Gray"
                                                BorderThickness="1,1,1,0"
                                                CornerRadius="3,3,0,0"
                                                Cursor="SizeAll"
                                                Background="Transparent"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                PreviewMouseDown="AnnotationDragHandle_PreviewMouseDown">
                                        <Border.Style>
                                                <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                        Value="Transparent"/>
                                                        <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}"
                                                                                Value="True">
                                                                        <Setter Property="Background"
                                                                                        Value="#DDDDDD"/>
                                                                </DataTrigger>
                                                        </Style.Triggers>
                                                </Style>
                                        </Border.Style>
                                        <TextBlock Text="::"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="Gray"
                                                        FontWeight="Bold"
                                                        FontSize="10"/>
                                </Border>

                                <Border Grid.Row="1"
                                                BorderBrush="Gray"
                                                BorderThickness="1"
                                                Background="#EEFFFFFF">
                                        <TextBox Text="{Binding TextContent, Mode=OneWay}"
                                                 FontFamily="{Binding FontFamily}"
                                                 FontSize="{Binding FontSize}"
                                                 FontWeight="{Binding IsBold, Converter={StaticResource BoolToFontWeightConverter}}"
                                                 Foreground="{Binding Foreground}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FocusVisualStyle="{x:Null}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Padding="5"
                                                 Loaded="AnnotationTextBox_Loaded"
                                                 GotFocus="AnnotationTextBox_GotFocus"
                                                 LostFocus="AnnotationTextBox_LostFocus"
                                                  PreviewKeyDown="AnnotationTextBox_PreviewKeyDown"
                                                  TextChanged="AnnotationTextBox_TextChanged"/>
                                </Border>

                                <Rectangle Grid.RowSpan="2"
                                           Stroke="#1976D2"
                                           StrokeThickness="1.5"
                                           StrokeDashArray="3 2"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <Thumb Grid.Row="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Width="10"
                                                Height="10"
                                                Cursor="SizeNWSE"
                                                DragDelta="ResizeThumb_DragDelta"
                                                Background="Gray"
                                                Opacity="0.5"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                </DataTemplate>

                <DataTemplate x:Key="HighlightTemplate">
                        <Border Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        Background="{Binding Background}"
                                        Cursor="Hand"
                                        PreviewMouseDown="Annotation_PreviewMouseDown"/>
                </DataTemplate>

                <DataTemplate x:Key="UnderlineTemplate">
                        <Border Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        Background="{Binding Background}"
                                        Cursor="Hand"
                                        PreviewMouseDown="Annotation_PreviewMouseDown"/>
                </DataTemplate>

                <DataTemplate x:Key="SearchHighlightTemplate">
                        <Border Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        Background="{Binding Background}"/>
                </DataTemplate>

                <DataTemplate x:Key="SignatureFieldTemplate">
                        <Button Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="클릭하여 서명 검증"
                                        Click="BtnVerifySignature_Click">
                                <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0"/>
                                        </ControlTemplate>
                                </Button.Template>
                        </Button>
                </DataTemplate>

                <DataTemplate x:Key="ImageStampTemplate">
                        <Grid Width="{Binding Width}"
                              Height="{Binding Height}"
                              Cursor="SizeAll">
                                <Image Source="{Binding ImageSource}"
                                       Stretch="Fill"
                                       SnapsToDevicePixels="True"
                                       PreviewMouseDown="Annotation_PreviewMouseDown"/>
                                <Rectangle Stroke="#1976D2"
                                           StrokeThickness="1.5"
                                           StrokeDashArray="3 2"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Thumb HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Width="10"
                                       Height="10"
                                       Cursor="SizeNWSE"
                                       DragDelta="ResizeThumb_DragDelta"
                                       Background="#1976D2"
                                       Opacity="0.65"
                                       Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                </DataTemplate>

                <!-- ── 툴바 ── 아이콘(Segoe MDL2 Assets) + 짧은 이름, 기능별 묶음 -->
                <SolidColorBrush x:Key="ToolbarBackground" Color="#F7F8FA"/>
                <SolidColorBrush x:Key="ToolHover" Color="#E8EEF7"/>
                <SolidColorBrush x:Key="ToolPressed" Color="#D6E2F3"/>
                <SolidColorBrush x:Key="ToolChecked" Color="#DCE8FA"/>
                <SolidColorBrush x:Key="ToolAccent" Color="#2F6FD6"/>
                <SolidColorBrush x:Key="ToolText" Color="#2B2F36"/>
                <SolidColorBrush x:Key="GroupLabel" Color="#8A9099"/>

                <Style x:Key="ToolIcon" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,1,0,2"/>
                </Style>
                <Style x:Key="ToolLabel" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                </Style>
                <Style x:Key="GroupCaption" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Foreground" Value="{StaticResource GroupLabel}"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,1,0,0"/>
                </Style>
                <!-- 묶음 사이 세로 구분선 -->
                <Style x:Key="GroupDivider" TargetType="Rectangle">
                        <Setter Property="Width" Value="1"/>
                        <Setter Property="Fill" Value="#DDE1E6"/>
                        <Setter Property="Margin" Value="6,6"/>
                </Style>

                <Style x:Key="ToolButton" TargetType="ButtonBase">
                        <Setter Property="Foreground" Value="{StaticResource ToolText}"/>
                        <Setter Property="MinWidth" Value="46"/>
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="Margin" Value="1,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="ButtonBase">
                                                <Border x:Name="Chrome"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ToolHover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ToolPressed}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.38"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
                <!-- 고르는 도구(선택·형광펜·텍스트, 굵게): 켜져 있으면 파란 테두리 -->
                <Style x:Key="ToolChoice" TargetType="ToggleButton">
                        <Setter Property="Foreground" Value="{StaticResource ToolText}"/>
                        <Setter Property="MinWidth" Value="46"/>
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="Margin" Value="1,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Chrome"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ToolHover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ToolChecked}"/>
                                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ToolAccent}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource ToolAccent}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.38"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- 읽기 | 편집 전환 (나란히 붙은 단추) -->
                <Style x:Key="ModeSegment" TargetType="RadioButton">
                        <Setter Property="Foreground" Value="{StaticResource ToolText}"/>
                        <Setter Property="Padding" Value="12,4"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Chrome"
                                                                Background="White"
                                                                BorderBrush="#C9CFD8"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                                Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ToolHover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ToolAccent}"/>
                                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ToolAccent}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
        </Window.Resources>

        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 툴바: 기능별 묶음(파일·모드·도구·페이지·문서·보기·찾기·글자). 창이 좁으면 묶음 단위로 다음 줄로 -->
                <Border Grid.Row="0"
                                Background="{StaticResource ToolbarBackground}"
                                BorderBrush="#DDE1E6"
                                BorderThickness="0,0,0,1"
                                Padding="6,3">
                        <WrapPanel Orientation="Horizontal">

                                <!-- 파일 -->
                                <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                                <Button Name="BtnOpen" Style="{StaticResource ToolButton}" Click="BtnOpen_Click" ToolTip="PDF 열기 (Ctrl+O)">
                                                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8E5;"/><TextBlock Style="{StaticResource ToolLabel}" Text="열기"/></StackPanel>
                                                </Button>
                                                <Button Name="BtnSave" Style="{StaticResource ToolButton}" Click="BtnSave_Click" ToolTip="저장 (Ctrl+S)">
                                                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74E;"/><TextBlock Style="{StaticResource ToolLabel}" Text="저장"/></StackPanel>
                                                </Button>
                                                <Button Name="BtnSaveAs" Style="{StaticResource ToolButton}" Click="BtnSaveAs_Click" ToolTip="다른 이름으로 저장">
                                                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE792;"/><TextBlock Style="{StaticResource ToolLabel}" Text="다른 이름"/></StackPanel>
                                                </Button>
                                                <Button Name="BtnPrint" Style="{StaticResource ToolButton}" Click="BtnPrint_Click" ToolTip="인쇄 (Ctrl+P) — 인쇄 제한 문서도 인쇄">
                                                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE749;"/><TextBlock Style="{StaticResource ToolLabel}" Text="인쇄"/></StackPanel>
                                                </Button>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource GroupCaption}" Text="파일"/>
                                </StackPanel>
                                <Rectangle Style="{StaticResource GroupDivider}"/>

                                <!-- 모드 -->
                                <StackPanel VerticalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,7,2,6">
                                                <RadioButton Name="RbReadMode"
                                                                GroupName="ViewMode"
                                                                Style="{StaticResource ModeSegment}"
                                                                Tag="4,0,0,4"
                                                                BorderThickness="1"
                                                                IsChecked="True"
                                                                Checked="Mode_Checked"
                                                                ToolTip="읽기: 보기·형광펜·검색">
                                                        <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE736;" FontSize="13" Margin="0,1,5,0"/>
                                                                <TextBlock Text="읽기"/>
                                                        </StackPanel>
                                                </RadioButton>
                                                <RadioButton Name="RbEditMode"
                                                                GroupName="ViewMode"
                                                                Style="{StaticResource ModeSegment}"
                                                                Tag="0,4,4,0"
                                                                BorderThickness="0,1,1,1"
                                                                Checked="Mode_Checked"
                                                                ToolTip="편집: 텍스트·페이지·서명·OCR">
                                                        <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="13" Margin="0,1,5,0"/>
                                                                <TextBlock Text="편집"/>
                                                        </StackPanel>
                                                </RadioButton>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource GroupCaption}" Text="모드"/>
                                </StackPanel>
                                <Rectangle Style="{StaticResource GroupDivider}"/>

                                <!-- 도구 -->
                                <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                                <RadioButton Name="RbCursor"
                                                                GroupName="Tools"
                                                                Style="{StaticResource ToolChoice}"
                                                                IsChecked="True"
                                                                Checked="Tool_Checked"
                                                                ToolTip="선택·이동 (Space를 누른 채 끌면 화면 이동)">
                                                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE7C9;"/><TextBlock Style="{StaticResource ToolLabel}" Text="선택"/></StackPanel>
                                                </RadioButton>
                                                <StackPanel Name="ViewToolsToolbar" Orientation="Horizontal">
                                                        <RadioButton Name="RbHighlight"
                                                                        GroupName="Tools"
                                                                        Style="{StaticResource ToolChoice}"
                                                                        Checked="Tool_Checked"
                                                                        ToolTip="형광펜: 글자 위를 끌어서 칠하기">
                                                                <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE7E6;"/><TextBlock Style="{StaticResource ToolLabel}" Text="형광펜"/></StackPanel>
                                                        </RadioButton>
                                                </StackPanel>
                                                <StackPanel Name="EditToolItems" Orientation="Horizontal" Visibility="Collapsed">
                                                        <RadioButton Name="RbText"
                                                                        GroupName="Tools"
                                                                        Style="{StaticResource ToolChoice}"
                                                                        Checked="Tool_Checked"
                                                                        ToolTip="텍스트 상자: 페이지를 눌러 넣기">
                                                                <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8D2;"/><TextBlock Style="{StaticResource ToolLabel}" Text="텍스트"/></StackPanel>
                                                        </RadioButton>
                                                        <Button Name="BtnDeleteAnnotation"
                                                                        Style="{StaticResource ToolButton}"
                                                                        Click="BtnDeleteAnnotation_Click"
                                                                        IsEnabled="False"
                                                                        ToolTip="선택한 주석 삭제 (Delete)">
                                                                <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74D;"/><TextBlock Style="{StaticResource ToolLabel}" Text="주석 삭제"/></StackPanel>
                                                        </Button>
                                                </StackPanel>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource GroupCaption}" Text="도구"/>
                                </StackPanel>
                                <Rectangle Style="{StaticResource GroupDivider}"/>

                                <!-- 편집 모드 전용: 페이지 · 문서 -->
                                <StackPanel Name="EditToolsToolbar" Orientation="Horizontal" Visibility="Collapsed">
                                        <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource ToolButton}" Click="BtnAddBlankPage_Click" ToolTip="현재 페이지 뒤에 빈 페이지 추가">
                                                                <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE7C3;"/><TextBlock Style="{StaticResource ToolLabel}" Text="빈 페이지"/></StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource ToolButton}" Click="BtnDeletePage_Click" ToolTip="선택한(또는 현재) 페이지 삭제">
                                                                <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE74D;"/><TextBlock Style="{StaticResource ToolLabel}" Text="삭제"/></StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource ToolButton}" Click="BtnRotateLeft_Click" ToolTip="왼쪽으로 90° 회전">
                                                                <StackPanel>
                                                                        <TextBlock Style="{StaticResource ToolIcon}" Text="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                                                                <TextBlock.RenderTransform><ScaleTransform ScaleX="-1"/></TextBlock.RenderTransform>
                                                                        </TextBlock>
                                                                        <TextBlock Style="{StaticResource ToolLabel}" Text="왼쪽"/>
                                                                </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource ToolButton}" Click="BtnRotateRight_Click" ToolTip="오른쪽으로 90° 회전">
                                                                <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE7AD;"/><TextBlock Style="{StaticResource ToolLabel}" Text="오른쪽"/></StackPanel>
                                                        </Button>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource GroupCaption}" Text="페이지"/>
                                        </StackPanel>
                                        <Rectangle Style="{StaticResource GroupDivider}"/>
                                        <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                        <Button Name="BtnSign" Style="{StaticResource ToolButton}" Click="BtnSign_Click" ToolTip="전자서명 자리 넣기 → 두 번 눌러 서명">
                                                                <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE72E;"/><TextBlock Style="{StaticResource ToolLabel}" Text="전자서명"/></StackPanel>
                                                        </Button>
                                                        <Button Name="BtnOCR" Style="{StaticResource ToolButton}" Click="BtnOCR_Click" ToolTip="글자 인식(OCR) → 검색 가능한 PDF">
                                                                <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE890;"/><TextBlock Style="{StaticResource ToolLabel}" Text="OCR"/></StackPanel>
                                                        </Button>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource GroupCaption}" Text="문서"/>
                                        </StackPanel>
                                        <Rectangle Style="{StaticResource GroupDivider}"/>
                                </StackPanel>

                                <!-- 보기 -->
                                <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                                <Button Name="BtnZoomOut" Style="{StaticResource ToolButton}" MinWidth="34" Click="BtnZoomOut_Click" ToolTip="축소 (Ctrl+휠)">
                                                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE71F;"/><TextBlock Style="{StaticResource ToolLabel}" Text="축소"/></StackPanel>
                                                </Button>
                                                <Button Name="BtnActualSize" Style="{StaticResource ToolButton}" MinWidth="52" Click="BtnActualSize_Click" ToolTip="실제 크기 100% (Ctrl+0)">
                                                        <StackPanel>
                                                                <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,2"
                                                                                Text="{Binding SelectedDocument.Zoom, StringFormat={}{0:P0}, FallbackValue=100%, TargetNullValue=100%}"/>
                                                                <TextBlock Style="{StaticResource ToolLabel}" Text="실제 크기"/>
                                                        </StackPanel>
                                                </Button>
                                                <Button Name="BtnZoomIn" Style="{StaticResource ToolButton}" MinWidth="34" Click="BtnZoomIn_Click" ToolTip="확대 (Ctrl+휠)">
                                                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8A3;"/><TextBlock Style="{StaticResource ToolLabel}" Text="확대"/></StackPanel>
                                                </Button>
                                                <Button Name="BtnFitWidth" Style="{StaticResource ToolButton}" Click="BtnFitWidth_Click" ToolTip="페이지 폭을 창에 맞춤">
                                                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE9A6;"/><TextBlock Style="{StaticResource ToolLabel}" Text="폭 맞춤"/></StackPanel>
                                                </Button>
                                                <Button Name="BtnFitHeight" Style="{StaticResource ToolButton}" Click="BtnFitHeight_Click" ToolTip="한 페이지 전체를 창에 맞춤">
                                                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE740;"/><TextBlock Style="{StaticResource ToolLabel}" Text="쪽 맞춤"/></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource ToolButton}" Click="BtnToggleSidebar_Click" ToolTip="썸네일·책갈피 패널 열기/닫기">
                                                        <StackPanel><TextBlock Style="{StaticResource ToolIcon}" Text="&#xE8A0;"/><TextBlock Style="{StaticResource ToolLabel}" Text="패널"/></StackPanel>
                                                </Button>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource GroupCaption}" Text="보기"/>
                                </StackPanel>
                                <Rectangle Style="{StaticResource GroupDivider}"/>

                                <!-- 찾기 -->
                                <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="2,6,2,5">
                                                <Border BorderBrush="#C9CFD8" BorderThickness="1" CornerRadius="4" Background="White" Height="26">
                                                        <StackPanel Orientation="Horizontal">
                                                                <Button Name="BtnSearch" Style="{StaticResource ToolButton}" MinWidth="26" Padding="4,0" Margin="0" Click="BtnSearch_Click" ToolTip="찾기 (Enter)">
                                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="13" Foreground="#6B7280"/>
                                                                </Button>
                                                                <TextBox Name="TxtSearch"
                                                                                Width="160"
                                                                                BorderThickness="0"
                                                                                VerticalContentAlignment="Center"
                                                                                PreviewKeyDown="TxtSearch_PreviewKeyDown"
                                                                                ToolTip="Ctrl+F · Enter 다음 · Ctrl+Enter 이전"/>
                                                        </StackPanel>
                                                </Border>
                                                <Button Name="BtnPrevSearch" Style="{StaticResource ToolButton}" MinWidth="26" Padding="4,0" Click="BtnPrevSearch_Click" ToolTip="이전 (Ctrl+Enter)">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70E;" FontSize="13"/>
                                                </Button>
                                                <Button Name="BtnNextSearch" Style="{StaticResource ToolButton}" MinWidth="26" Padding="4,0" Click="BtnNextSearch_Click" ToolTip="다음 (Enter)">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" FontSize="13"/>
                                                </Button>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource GroupCaption}" Text="찾기"/>
                                </StackPanel>

                                <!-- 글자 (텍스트 상자를 고르거나 텍스트 도구일 때만) -->
                                <StackPanel Name="TextStyleToolbar" Orientation="Horizontal" Visibility="Collapsed">
                                        <Rectangle Style="{StaticResource GroupDivider}"/>
                                        <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="2,6,2,5" Height="26">
                                                        <ComboBox Name="CbFont" Width="120" Margin="0,0,4,0" VerticalContentAlignment="Center" SelectionChanged="StyleChanged" ToolTip="글꼴"/>
                                                        <ComboBox Name="CbSize" Width="54" Margin="0,0,4,0" VerticalContentAlignment="Center" SelectionChanged="StyleChanged" ToolTip="크기"/>
                                                        <ToggleButton Name="BtnBold" Style="{StaticResource ToolChoice}" MinWidth="26" Padding="4,0" Margin="0,0,4,0" Click="StyleChanged" ToolTip="굵게">
                                                                <TextBlock Text="B" FontWeight="Bold" FontSize="13"/>
                                                        </ToggleButton>
                                                        <ComboBox Name="CbColor" Width="72" VerticalContentAlignment="Center" SelectionChanged="StyleChanged" ToolTip="글자 색">
                                                                <ComboBoxItem Content="검정" Tag="Black" IsSelected="True"/>
                                                                <ComboBoxItem Content="빨강" Tag="Red" Foreground="Red"/>
                                                                <ComboBoxItem Content="파랑" Tag="Blue" Foreground="Blue"/>
                                                                <ComboBoxItem Content="초록" Tag="Green" Foreground="Green"/>
                                                                <ComboBoxItem Content="주황" Tag="Orange" Foreground="Orange"/>
                                                        </ComboBox>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource GroupCaption}" Text="글자"/>
                                        </StackPanel>
                                </StackPanel>
                        </WrapPanel>
                </Border>

                <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SidebarColumn"
                                                Width="0"
                                                MinWidth="0"
                                                MaxWidth="520"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Name="SidebarBorder"
                                        Grid.Column="0"
                                        BorderBrush="Gray"
                                        BorderThickness="0,0,1,0"
                                        Background="#F5F5F5"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Stretch">
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0"
                                                        Margin="5">
                                                <TextBlock Text="패널"
                                                                FontWeight="Bold"
                                                                VerticalAlignment="Center"
                                                                DockPanel.Dock="Left"/>
                                                <Button Content="✖"
                                                                Width="20"
                                                                Height="20"
                                                                HorizontalAlignment="Right"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="BtnToggleSidebar_Click"/>
                                        </DockPanel>

                                        <TabControl Grid.Row="1"
                                                        Background="Transparent"
                                                        BorderThickness="0">
                                                <TabItem Header="페이지">
                                                        <ListBox Name="PageThumbnailList"
                                                                        ItemsSource="{Binding SelectedDocument.Pages}"
                                                                        BorderThickness="0"
                                                                        Background="Transparent"
                                                                        AllowDrop="True"
                                                                        SelectionMode="Extended"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        ScrollViewer.CanContentScroll="True"
                                                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                        ScrollViewer.ScrollChanged="PageThumbnailList_ScrollChanged"
                                                                        PreviewMouseWheel="DocumentZoom_PreviewMouseWheel"
                                                                        VirtualizingPanel.IsVirtualizing="True"
                                                                        VirtualizingPanel.VirtualizationMode="Recycling"
                                                                        SelectionChanged="PageThumbnailList_SelectionChanged"
                                                                        PreviewMouseLeftButtonDown="PageThumbnailList_PreviewMouseLeftButtonDown"
                                                                        PreviewMouseMove="PageThumbnailList_PreviewMouseMove"
                                                                        PreviewMouseLeftButtonUp="PageThumbnailList_PreviewMouseLeftButtonUp"
                                                                        DragOver="PageThumbnailList_DragOver"
                                                                        Drop="PageThumbnailList_Drop">
                                                                <ListBox.ItemContainerStyle>
                                                                        <Style TargetType="ListBoxItem">
                                                                                <Setter Property="HorizontalContentAlignment"
                                                                                                Value="Stretch"/>
                                                                                <Setter Property="Margin"
                                                                                                Value="0,2"/>
                                                                                <Setter Property="AllowDrop"
                                                                                                Value="True"/>
                                                                                <EventSetter Event="PreviewMouseLeftButtonDown"
                                                                                                Handler="PageThumbnailItem_PreviewMouseLeftButtonDown"/>
                                                                                <EventSetter Event="PreviewMouseMove"
                                                                                                Handler="PageThumbnailItem_PreviewMouseMove"/>
                                                                                <EventSetter Event="PreviewMouseLeftButtonUp"
                                                                                                Handler="PageThumbnailItem_PreviewMouseLeftButtonUp"/>
                                                                        </Style>
                                                                </ListBox.ItemContainerStyle>
                                                                <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                                <StackPanel Margin="8,6"
                                                                                                HorizontalAlignment="Center">
                                                                                        <Border Width="{Binding DataContext.ThumbnailFrameWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                        MinHeight="80"
                                                                                                        Background="White"
                                                                                                        BorderBrush="#C8C8C8"
                                                                                                        BorderThickness="1"
                                                                                                        Padding="4">
                                                                                                <Image Source="{Binding ThumbnailSource}"
                                                                                                                Width="{Binding DataContext.ThumbnailImageWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                                Stretch="Uniform"
                                                                                                                SnapsToDevicePixels="True"/>
                                                                                        </Border>
                                                                                        <TextBlock Text="{Binding PageNumber, StringFormat='페이지 {0}'}"
                                                                                                        Margin="0,4,0,0"
                                                                                                        HorizontalAlignment="Center"
                                                                                                        FontSize="11"
                                                                                                        Foreground="#555"/>
                                                                                </StackPanel>
                                                                        </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                        </ListBox>
                                                </TabItem>
                                                <TabItem Header="책갈피">
                                                        <Grid>
                                                                <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>

                                                                <ToolBarTray Grid.Row="0"
                                                                                Background="Transparent">
                                                                        <ToolBar Background="Transparent"
                                                                                        OverflowMode="Never">
                                                                                <Button Content="➕"
                                                                                                ToolTip="현재 페이지 추가"
                                                                                                Click="BtnAddBookmark_Click"/>
                                                                                <Button Content="➖"
                                                                                                ToolTip="삭제"
                                                                                                Click="BtnDeleteBookmark_Click"/>
                                                                                <Separator/>
                                                                                <Button Content="▲"
                                                                                                ToolTip="위로"
                                                                                                Click="BtnMoveBookmarkUp_Click"/>
                                                                                <Button Content="▼"
                                                                                                ToolTip="아래로"
                                                                                                Click="BtnMoveBookmarkDown_Click"/>
                                                                        </ToolBar>
                                                                </ToolBarTray>

                                                                <TreeView Grid.Row="1"
                                                                                Name="BookmarkTree"
                                                                                ItemsSource="{Binding SelectedDocument.Bookmarks}"
                                                                                BorderThickness="0"
                                                                                Background="Transparent"
                                                                                AllowDrop="True"
                                                                                PreviewMouseLeftButtonDown="BookmarkTree_PreviewMouseLeftButtonDown"
                                                                                PreviewMouseMove="BookmarkTree_PreviewMouseMove"
                                                                                Drop="BookmarkTree_Drop"
                                                                                DragOver="BookmarkTree_DragOver"
                                                                                SelectedItemChanged="BookmarkTree_SelectedItemChanged"
                                                                                KeyDown="BookmarkTree_KeyDown">
                                                                        <TreeView.ItemTemplate>
                                                                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                                                        <StackPanel Orientation="Horizontal"
                                                                                                        Background="Transparent">
                                                                                                <Grid Margin="0,0,5,0">
                                                                                                        <TextBlock Text="{Binding Title}"
                                                                                                                        VerticalAlignment="Center">
                                                                                                                <TextBlock.Style>
                                                                                                                        <Style TargetType="TextBlock">
                                                                                                                                <Setter Property="Visibility"
                                                                                                                                                Value="Visible"/>
                                                                                                                                <Style.Triggers>
                                                                                                                                        <DataTrigger Binding="{Binding IsEditing}"
                                                                                                                                                        Value="True">
                                                                                                                                                <Setter Property="Visibility"
                                                                                                                                                                Value="Collapsed"/>
                                                                                                                                        </DataTrigger>
                                                                                                                                </Style.Triggers>
                                                                                                                        </Style>
                                                                                                                </TextBlock.Style>
                                                                                                        </TextBlock>
                                                                                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                                                                                        VerticalAlignment="Center"
                                                                                                                        KeyDown="BookmarkRename_KeyDown"
                                                                                                                        LostFocus="BookmarkRename_LostFocus"
                                                                                                                        IsVisibleChanged="BookmarkRename_IsVisibleChanged">
                                                                                                                <TextBox.Style>
                                                                                                                        <Style TargetType="TextBox">
                                                                                                                                <Setter Property="Visibility"
                                                                                                                                                Value="Collapsed"/>
                                                                                                                                <Style.Triggers>
                                                                                                                                        <DataTrigger Binding="{Binding IsEditing}"
                                                                                                                                                        Value="True">
                                                                                                                                                <Setter Property="Visibility"
                                                                                                                                                                Value="Visible"/>
                                                                                                                                        </DataTrigger>
                                                                                                                                </Style.Triggers>
                                                                                                                        </Style>
                                                                                                                </TextBox.Style>
                                                                                                        </TextBox>
                                                                                                </Grid>
                                                                                                <TextBlock Text="{Binding PageNumber, StringFormat=' (p.{0})'}"
                                                                                                                Foreground="Gray"
                                                                                                                FontSize="10"
                                                                                                                VerticalAlignment="Center"
                                                                                                                IsHitTestVisible="False"/>
                                                                                                <StackPanel.ContextMenu>
                                                                                                        <ContextMenu>
                                                                                                                <MenuItem Header="이름 변경 (F2)"
                                                                                                                                Click="BtnRenameBookmark_Click"/>
                                                                                                                <MenuItem Header="현재 페이지로 위치 갱신"
                                                                                                                                Click="BtnUpdateBookmarkPage_Click"/>
                                                                                                                <Separator/>
                                                                                                                <MenuItem Header="삭제"
                                                                                                                                Click="BtnDeleteBookmark_Click"/>
                                                                                                        </ContextMenu>
                                                                                                </StackPanel.ContextMenu>
                                                                                        </StackPanel>
                                                                                </HierarchicalDataTemplate>
                                                                        </TreeView.ItemTemplate>
                                                                        <TreeView.ItemContainerStyle>
                                                                                <Style TargetType="TreeViewItem">
                                                                                        <Setter Property="IsExpanded"
                                                                                                        Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                                                        <Setter Property="IsSelected"
                                                                                                        Value="{Binding IsSelected, Mode=TwoWay}"/>
                                                                                </Style>
                                                                        </TreeView.ItemContainerStyle>
                                                                </TreeView>
                                                        </Grid>
                                                </TabItem>
                                        </TabControl>
                                </Grid>
                        </Border>

                        <GridSplitter x:Name="SidebarSplitter"
                                        Grid.Column="1"
                                        Width="5"
                                        HorizontalAlignment="Stretch"
                                        Background="LightGray"
                                        ResizeBehavior="PreviousAndNext"
                                        Visibility="Collapsed"/>

                        <TabControl Name="MainTabControl"
                                        Grid.Column="2"
                                        ItemsSource="{Binding Documents}"
                                        SelectedItem="{Binding SelectedDocument}"
                                        SelectionChanged="MainTabControl_SelectionChanged">
                                <TabControl.ItemTemplate>
                                        <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding FileName}"
                                                                        Margin="0,0,5,0"/>
                                                        <Button Content="❌"
                                                                        Width="15"
                                                                        Height="15"
                                                                        FontSize="8"
                                                                        Tag="{Binding}"
                                                                        Click="BtnCloseTab_Click"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"/>
                                                </StackPanel>
                                        </DataTemplate>
                                </TabControl.ItemTemplate>

                                <TabControl.ContentTemplate>
                                        <DataTemplate>
                                                <ListView ItemsSource="{Binding Pages}"
                                                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                ScrollViewer.CanContentScroll="True"
                                                                ScrollViewer.ScrollChanged="PdfListView_ScrollChanged"
                                                                VirtualizingPanel.ScrollUnit="Pixel"
                                                                VirtualizingPanel.VirtualizationMode="Recycling"
                                                                Loaded="PdfListView_Loaded"
                                                                Unloaded="PdfListView_Unloaded"
                                                                Background="LightGray"
                                                                BorderThickness="0"
                                                                PreviewMouseWheel="DocumentZoom_PreviewMouseWheel"
                                                                PreviewMouseDown="ListView_PreviewMouseDown">
                                                                                <ListView.ItemContainerStyle>
                                                                                        <Style TargetType="ListViewItem">
                                                                                                <Setter Property="Margin"
                                                                                                                Value="10"/>
                                                                                                <Setter Property="HorizontalContentAlignment"
                                                                                                                Value="Center"/>
                                                                                                <Setter Property="Focusable"
                                                                                                                Value="False"/>
                                                                                        </Style>
                                                                                </ListView.ItemContainerStyle>
                                                        <ListView.ItemTemplate>
                                                                <DataTemplate>
                                                                        <Grid>
                                                                                <!-- 그림자는 형제 요소로: 페이지에 Effect를 걸면 페이지 전체가 다시 래스터화돼 글자가 흐려진다 -->
                                                                                <Border Background="#59000000"
                                                                                                Margin="4,5,-4,-5"
                                                                                                IsHitTestVisible="False">
                                                                                        <Border.Effect>
                                                                                                <BlurEffect Radius="8"/>
                                                                                        </Border.Effect>
                                                                                </Border>
                                                                        <Border BorderBrush="Black"
                                                                                        BorderThickness="1"
                                                                                        Background="White">

                                                                                <Grid x:Name="PageGrid"
                                                                                                Width="{Binding Width}"
                                                                                                Height="{Binding Height}"
                                                                                                Tag="{Binding PageIndex}"
                                                                                                SnapsToDevicePixels="True"
                                                                                                UseLayoutRounding="True"
                                                                                                Loaded="PageGrid_Loaded"
                                                                                                Unloaded="PageGrid_Unloaded"
                                                                                                PreviewMouseDown="Page_MouseDown"
                                                                                                PreviewMouseMove="Page_MouseMove"
                                                                                                PreviewMouseUp="Page_MouseUp"
                                                                                                Background="Transparent">
                                                                                        <!-- 고해상도 그림이 오기 전 자리 표시 (썸네일). 그림은 회전까지 반영된 비트맵이라 변환 없이 칸에 맞춘다 -->
                                                                                        <Image Source="{Binding ThumbnailSource}"
                                                                                                        Stretch="Fill"
                                                                                                        RenderOptions.BitmapScalingMode="LowQuality"
                                                                                                        IsHitTestVisible="False"/>
                                                                                        <Image Source="{Binding ImageSource}"
                                                                                                        Stretch="Fill"
                                                                                                        SnapsToDevicePixels="True"
                                                                                                        UseLayoutRounding="True"
                                                                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                                                                        IsHitTestVisible="False"/>
                                                                                        <!-- 고배율: 보이는 부분만 화면 해상도로 그린 타일 -->
                                                                                        <Canvas IsHitTestVisible="False">
                                                                                                <Image Source="{Binding DetailImageSource}"
                                                                                                                Canvas.Left="{Binding DetailRect.X}"
                                                                                                                Canvas.Top="{Binding DetailRect.Y}"
                                                                                                                Width="{Binding DetailRect.Width}"
                                                                                                                Height="{Binding DetailRect.Height}"
                                                                                                                Stretch="Fill"
                                                                                                                SnapsToDevicePixels="True"
                                                                                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                                        </Canvas>

                                                                        <Canvas Background="Transparent"
                                                                                                        IsHitTestVisible="False">
                                                                                                <Border Canvas.Left="{Binding SelectionX}"
                                                                                                                Canvas.Top="{Binding SelectionY}"
                                                                                                                Width="{Binding SelectionWidth}"
                                                                                                                Height="{Binding SelectionHeight}"
                                                                                                                Visibility="{Binding IsSelecting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                                        <Border.Style>
                                                                                                                <Style TargetType="Border">
                                                                                                                        <Setter Property="BorderBrush" Value="Blue"/>
                                                                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                                                                        <Setter Property="Background" Value="#300000FF"/>
                                                                                                                        <Style.Triggers>
                                                                                                                                <DataTrigger Binding="{Binding IsHighlighting}" Value="True">
                                                                                                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                                                                                                        <Setter Property="BorderThickness" Value="0"/>
                                                                                                                                        <Setter Property="Background" Value="#50FFFF00"/>
                                                                                                                                </DataTrigger>
                                                                                                                        </Style.Triggers>
                                                                                                                </Style>
                                                                                                        </Border.Style>
                                                                                                </Border>
                                                                                        </Canvas>

                                                                                        <Canvas x:Name="AnnotationCanvas"
                                                                                                        HorizontalAlignment="Stretch"
                                                                                                        VerticalAlignment="Stretch"
                                                                                                        Loaded="AnnotationCanvas_Loaded"/>
                                                                                </Grid>
                                                                        </Border>
                                                                        </Grid>
                                                                </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                </ListView>
                                        </DataTemplate>
                                </TabControl.ContentTemplate>
                        </TabControl>
                </Grid>

                <StatusBar Grid.Row="2">
                        <StatusBarItem>
                                <TextBlock x:Name="TxtStatus"
                                                Text="준비"/>
                        </StatusBarItem>
                        <StatusBarItem>
                                <ProgressBar x:Name="PbStatus"
                                                Width="100"
                                                Height="15"
                                                Visibility="Collapsed"/>
                        </StatusBarItem>
                        <StatusBarItem HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtPageInfo"
                                                Text="0 / 0"
                                                FontWeight="Bold"
                                                Margin="0,0,20,0"/>
                        </StatusBarItem>
                        <StatusBarItem HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                        <Button Content="-"
                                                        Click="BtnZoomOut_Click"
                                                        Width="20"/>
                                        <Slider Minimum="0.1"
                                                        Maximum="5.0"
                                                        Value="{Binding SelectedDocument.Zoom}"
                                                        Width="100"/>
                                        <Button Content="+"
                                                        Click="BtnZoomIn_Click"
                                                        Width="20"/>
                                </StackPanel>
                        </StatusBarItem>
                </StatusBar>

                <Popup Name="SelectionPopup"
                                StaysOpen="False"
                                Placement="Bottom">
                        <Border Background="White"
                                        BorderBrush="Gray"
                                        BorderThickness="1"
                                        Padding="5">
                                <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnPopupCopy"
                                                        Content="복사"
                                                        Click="BtnPopupCopy_Click"
                                                        Margin="2"/>
                                        <Button Content="이미지 복사"
                                                        Click="BtnPopupCopyImage_Click"
                                                        Margin="2"/>
                                        <Button Content="형광펜(초록)"
                                                        Click="BtnPopupHighlightGreen_Click"
                                                        Background="LightGreen"
                                                        Margin="2"/>
                                        <Button Content="형광펜(주황)"
                                                        Click="BtnPopupHighlightOrange_Click"
                                                        Background="Orange"
                                                        Margin="2"/>
                                        <Button Content="밑줄"
                                                        Click="BtnPopupUnderline_Click"
                                                        Margin="2"/>
                                </StackPanel>
                        </Border>
                </Popup>
        </Grid>
</Window>
